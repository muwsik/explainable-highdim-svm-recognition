{
    // Используйте IntelliSense, чтобы узнать о возможных атрибутах.
    // Наведите указатель мыши, чтобы просмотреть описания существующих атрибутов.
    "version": "0.2.0",
    "configurations": [        
        {
            "name": "Debug current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
        },
        {
            "name": "Debug CV experiment",
            "type": "debugpy",
            "request": "launch",
            "program": "combiningSubspaces/CV_experiment.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "--data",       "D:\\datasets\\sync-kit-10k-f1000-i1000-r0-l0.npz",
                "--C",          "0.1",
                "--model",      "Comb-LSVC-l1",
                "--splits",     "1",
                "--output",     "temp.xlsx",
                "--no-std", 
            ]
        },
        {
            "name": "Debug synthetic experiment",
            "type": "debugpy",
            "request": "launch",
            "program": "combiningSubspaces/synthetic_experiment.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "--data",       "D:\\Muws\\datasets\\synthetic1-10k-f1000-i1000-r0-l0.npz",
                "--C",          "0.1",
                "--model",      "Comb-LSVC-l1",
                "--train-size", "5000",
                "--skf-seed",   "123456",
                "--splits",     "1",
                "--output",     "temp.xlsx",
                "--no-std", 
            ]
        },
        {
            "name": "Debug split experiment",
            "type": "debugpy",
            "request": "launch",
            "program": "combiningSubspaces/split_experiment.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                 "--train",     "datasets\\gisette\\gisette_scale_tr.npz",
                "--test",       "datasets\\gisette\\gisette_scale_t.npz",
                "--C",          "0.1",
                "--model",      "Comb-LSVC-l1",
                "--splits",     "2",
                "--output",     "temp.xlsx",
                "--no-std", 
            ]
        }
    ]
}